<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
    <Authors>YS Laith</Authors>
    <Company>YS Laith</Company>
    <IsPackable>false</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/allaithking-png/WPF.YS.Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 
      CVE-2025-6965: SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11 (خطيرة).
      تأتي transitively عبر Microsoft.EntityFrameworkCore.Sqlite.
      لا يوجد إصدار مُرقَّع رسمي بعد.
      
      Track: https://github.com/dotnet/efcore/issues/38257
      
      TODO: أزل هذا الكتم عندما ينزل Microsoft.Data.Sqlite بإصلاح.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>
</Project>