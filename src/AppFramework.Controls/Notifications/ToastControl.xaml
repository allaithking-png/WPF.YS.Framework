<UserControl x:Class="AppFramework.Controls.Notifications.ToastControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="360" MinHeight="80">
    <Border x:Name="PART_Root"
            CornerRadius="8"
            Padding="16,12"
            Margin="8"
            Background="{DynamicResource App.BackgroundBrush}"
            BorderBrush="{DynamicResource App.BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- أيقونة الحالة -->
            <Border x:Name="PART_IconBorder"
                    Grid.Column="0"
                    Width="36" Height="36"
                    CornerRadius="18"
                    Margin="0,0,12,0"
                    Background="{DynamicResource App.PrimaryBrush}"
                    VerticalAlignment="Top">
                <TextBlock x:Name="PART_Icon"
                           Text="ℹ"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- المحتوى -->
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="PART_Title"
                           Text="عنوان"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="{DynamicResource App.TextPrimaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="PART_Message"
                           Text="رسالة"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                           Margin="0,0,0,8"/>

                <!-- الأزرار -->
                <ItemsControl x:Name="PART_Actions">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Command="{Binding Command}"
                                    Padding="12,4"
                                    Margin="0,0,6,0"
                                    FontSize="11"
                                    MinWidth="60"
                                    MinHeight="26"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- زر الإغلاق -->
            <Button x:Name="PART_CloseButton"
                    Grid.Column="2"
                    Content="✕"
                    Width="24" Height="24"
                    Padding="0"
                    MinWidth="0"
                    FontSize="12"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                    BorderThickness="0"
                    Click="OnCloseClicked"/>
        </Grid>
    </Border>
</UserControl>