<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <sys:String x:Key="AppFramework.Theme">Corporate</sys:String>

  <!-- ============ Colors ============ -->
  <Color x:Key="App.PrimaryColor">#0D47A1</Color>
  <Color x:Key="App.PrimaryDarkColor">#002171</Color>
  <Color x:Key="App.PrimaryLightColor">#E3F2FD</Color>
  <Color x:Key="App.SecondaryColor">#455A64</Color>
  <Color x:Key="App.SuccessColor">#2E7D32</Color>
  <Color x:Key="App.WarningColor">#F57F17</Color>
  <Color x:Key="App.ErrorColor">#C62828</Color>
  <Color x:Key="App.InfoColor">#1565C0</Color>

  <Color x:Key="App.BackgroundColor">#FAFAFA</Color>
  <Color x:Key="App.SurfaceColor">#ECEFF1</Color>
  <Color x:Key="App.Surface2Color">#E0E0E0</Color>
  <Color x:Key="App.Surface3Color">#CFD8DC</Color>
  <Color x:Key="App.BorderColor">#B0BEC5</Color>
  <Color x:Key="App.BorderStrongColor">#78909C</Color>

  <Color x:Key="App.TextPrimaryColor">#1A237E</Color>
  <Color x:Key="App.TextSecondaryColor">#546E7A</Color>
  <Color x:Key="App.TextDisabledColor">#90A4AE</Color>
  <Color x:Key="App.TextInverseColor">#FFFFFF</Color>

  <Color x:Key="App.HoverColor">#E3F2FD</Color>
  <Color x:Key="App.SelectedColor">#BBDEFB</Color>
  <Color x:Key="App.FocusColor">#0D47A1</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="App.PrimaryBrush" Color="{StaticResource App.PrimaryColor}" />
  <SolidColorBrush x:Key="App.PrimaryDarkBrush" Color="{StaticResource App.PrimaryDarkColor}" />
  <SolidColorBrush x:Key="App.PrimaryLightBrush" Color="{StaticResource App.PrimaryLightColor}" />
  <SolidColorBrush x:Key="App.SecondaryBrush" Color="{StaticResource App.SecondaryColor}" />
  <SolidColorBrush x:Key="App.SuccessBrush" Color="{StaticResource App.SuccessColor}" />
  <SolidColorBrush x:Key="App.WarningBrush" Color="{StaticResource App.WarningColor}" />
  <SolidColorBrush x:Key="App.ErrorBrush" Color="{StaticResource App.ErrorColor}" />
  <SolidColorBrush x:Key="App.InfoBrush" Color="{StaticResource App.InfoColor}" />

  <SolidColorBrush x:Key="App.BackgroundBrush" Color="{StaticResource App.BackgroundColor}" />
  <SolidColorBrush x:Key="App.SurfaceBrush" Color="{StaticResource App.SurfaceColor}" />
  <SolidColorBrush x:Key="App.Surface2Brush" Color="{StaticResource App.Surface2Color}" />
  <SolidColorBrush x:Key="App.Surface3Brush" Color="{StaticResource App.Surface3Color}" />
  <SolidColorBrush x:Key="App.BorderBrush" Color="{StaticResource App.BorderColor}" />
  <SolidColorBrush x:Key="App.BorderStrongBrush" Color="{StaticResource App.BorderStrongColor}" />

  <SolidColorBrush x:Key="App.TextPrimaryBrush" Color="{StaticResource App.TextPrimaryColor}" />
  <SolidColorBrush x:Key="App.TextSecondaryBrush" Color="{StaticResource App.TextSecondaryColor}" />
  <SolidColorBrush x:Key="App.TextDisabledBrush" Color="{StaticResource App.TextDisabledColor}" />
  <SolidColorBrush x:Key="App.TextInverseBrush" Color="{StaticResource App.TextInverseColor}" />

  <SolidColorBrush x:Key="App.HoverBrush" Color="{StaticResource App.HoverColor}" />
  <SolidColorBrush x:Key="App.SelectedBrush" Color="{StaticResource App.SelectedColor}" />
  <SolidColorBrush x:Key="App.FocusBrush" Color="{StaticResource App.FocusColor}" />

  <!-- Fonts -->
  <FontFamily x:Key="App.FontFamily">Segoe UI</FontFamily>
  <sys:Double x:Key="App.FontSizeSmall">11</sys:Double>
  <sys:Double x:Key="App.FontSizeNormal">13</sys:Double>
  <sys:Double x:Key="App.FontSizeLarge">15</sys:Double>
  <sys:Double x:Key="App.FontSizeTitle">20</sys:Double>

  <!-- Radii -->
  <CornerRadius x:Key="App.SmallRadius">3</CornerRadius>
  <CornerRadius x:Key="App.NormalRadius">5</CornerRadius>
  <CornerRadius x:Key="App.LargeRadius">8</CornerRadius>
</ResourceDictionary>
