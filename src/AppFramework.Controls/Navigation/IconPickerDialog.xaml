<Window x:Class="AppFramework.Controls.Navigation.IconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اختر أيقونة"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- رأس -->
        <Border Grid.Row="0" Background="{DynamicResource App.PrimaryBrush}" Padding="16,12">
            <TextBlock Text="🎨 اختر أيقونة"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource App.TextInverseBrush}"/>
        </Border>

        <!-- التصنيفات + بحث -->
        <StackPanel Grid.Row="1" Margin="16,12,16,6">
            <TextBox x:Name="PART_SearchBox"
                     MinHeight="32" Padding="8,4"
                     TextChanged="OnSearchChanged"
                     Tag="ابحث في الأيقونات..."/>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Disabled"
                          Margin="0,10,0,0">
                <ItemsControl x:Name="PART_Categories">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}"
                                    Tag="{Binding Id}"
                                    Click="OnCategoryClicked"
                                    Padding="10,4"
                                    Margin="0,0,6,0"
                                    Background="{DynamicResource App.SurfaceBrush}"
                                    Foreground="{DynamicResource App.TextPrimaryBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- شبكة الأيقونات -->
        <ScrollViewer Grid.Row="2" Margin="16,6,16,6"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PART_Icons">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding}"
                                Click="OnIconClicked"
                                Width="48" Height="48"
                                Margin="4"
                                Padding="0"
                                FontSize="22"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Content="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- أزرار -->
        <Border Grid.Row="3"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- إدخال يدوي -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="أو أدخل:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="PART_ManualBox" Width="80" MinHeight="28" Padding="6,2"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="إلغاء" Click="OnCancelClicked"
                            Margin="0,0,8,0" MinWidth="100"
                            Background="{DynamicResource App.SurfaceBrush}"
                            Foreground="{DynamicResource App.TextPrimaryBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="1"/>
                    <Button Content="✅ اختيار" Click="OnPickClicked" MinWidth="120"
                            Background="{DynamicResource App.PrimaryBrush}"
                            Foreground="{DynamicResource App.TextInverseBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>