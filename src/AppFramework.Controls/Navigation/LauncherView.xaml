<UserControl x:Class="AppFramework.Controls.Navigation.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             AllowDrop="True"
             Drop="OnRootDrop"
             DragOver="OnRootDragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- شريط الأدوات -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="🗂️ سطح المكتب"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource App.PrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="PART_AddButton"
                            Content="➕ إضافة"
                            Click="OnAddClicked"
                            Padding="10,6"
                            Margin="0,0,6,0"/>

                    <Button Content="📁 مجلد جديد"
                            Click="OnNewFolderClicked"
                            Padding="10,6"
                            Margin="0,0,6,0"/>

                    <Button Content="⚙️"
                            Click="OnSettingsClicked"
                            Padding="10,6"
                            MinWidth="36"
                            ToolTip="إعدادات العرض"/>

                    <Button Content="🔄"
                            Click="OnRefreshClicked"
                            Padding="10,6"
                            MinWidth="36"
                            Margin="6,0,0,0"
                            ToolTip="تحديث"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- شريط البحث + حالة -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource App.BackgroundBrush}"
                    Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔍" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <TextBox x:Name="PART_SearchBox" Grid.Column="1"
                             MinHeight="26" Padding="8,4"
                             VerticalContentAlignment="Center"/>

                    <Button x:Name="PART_ClearButton" Grid.Column="2"
                            Content="✖" Width="26" Height="26"
                            Padding="0" MinWidth="0" Margin="6,0,0,0"
                            Visibility="Collapsed" Click="OnClearSearchClicked"/>
                </Grid>
            </Border>

            <!-- المجموعات -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="8,10">
                <ItemsControl x:Name="PART_Groups"/>
            </ScrollViewer>

            <!-- حالة -->
      <Border Grid.Row="2"  Visibility="Hidden" 
                    Background="{DynamicResource App.SurfaceBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="10,4">
                <TextBlock x:Name="PART_Status" Visibility="Hidden"
                           FontSize="11"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
