<Window x:Class="AppFramework.Controls.Navigation.AddItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة عنصر"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource App.PrimaryBrush}" Padding="16,12">
            <TextBlock Text="➕ إضافة عنصر جديد"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource App.TextInverseBrush}"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,16">
            <!-- نوع العنصر -->
            <TextBlock Text="نوع العنصر" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="PART_KindCombo" MinHeight="32" Margin="0,0,0,14"
                      SelectionChanged="OnKindChanged">
                <ComboBoxItem Content="🖥️ شاشة" Tag="Screen"/>
                <ComboBoxItem Content="📊 تقرير" Tag="Report"/>
                <ComboBoxItem Content="🔗 رابط إلكتروني" Tag="Url"/>
                <ComboBoxItem Content="📄 ملف خارجي" Tag="ExternalFile"/>
                <ComboBoxItem Content="📁 مجلد خارجي" Tag="ExternalFolder"/>
                <ComboBoxItem Content="📂 مجلد محلي (تنظيمي)" Tag="LocalFolder"/>
            </ComboBox>

            <!-- العنوان -->
            <TextBlock Text="العنوان" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="PART_TitleBox" MinHeight="32" Margin="0,0,0,14" Padding="8,4"/>

            <!-- الهدف -->
            <TextBlock x:Name="PART_TargetLabel" Text="الهدف" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

        <!-- ComboBox للاختيار من المسجّلين (للشاشات والتقارير) -->
        <ComboBox x:Name="PART_TargetCombo"
          MinHeight="32" Margin="0,0,0,14"
          DisplayMemberPath="DisplayName"
          Visibility="Collapsed"/>

       
            </Grid>
      <!-- TextBox مع زر تصفح (للملفات والروابط) -->
      <Grid x:Name="PART_TargetBoxPanel" Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="PART_TargetBox" Grid.Column="0" MinHeight="32" Padding="8,4"/>

        <Button x:Name="PART_BrowseButton" Grid.Column="1"
            Content="..." Width="36" Margin="6,0,0,0"
            Click="OnBrowseClicked" Visibility="Collapsed"/>
      </Grid>
      <!-- المجلد الأب (اختياري) -->
            <TextBlock Text="داخل مجلد (اختياري)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="PART_FolderCombo" MinHeight="32" Margin="0,0,0,14"
                      DisplayMemberPath="Title"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إلغاء" Click="OnCancelClicked"
                        Margin="0,0,8,0" MinWidth="100"
                        Background="{DynamicResource App.SurfaceBrush}"
                        Foreground="{DynamicResource App.TextPrimaryBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"/>
                <Button Content="💾 إضافة" Click="OnAddClicked" MinWidth="120"
                        Background="{DynamicResource App.PrimaryBrush}"
                        Foreground="{DynamicResource App.TextInverseBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
