<UserControl x:Class="AppFramework.Controls.Navigation.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="320"
             Background="{DynamicResource App.BackgroundBrush}"
             BorderBrush="{DynamicResource App.BorderBrush}"
             BorderThickness="1,0,0,0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- رأس -->
        <Border Grid.Row="0" Background="{DynamicResource App.PrimaryBrush}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🕐" FontSize="16"
                           Foreground="{DynamicResource App.TextInverseBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <TextBlock Grid.Column="1" Text="سجل التغييرات"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextInverseBrush}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="✖"
                        Width="24" Height="24" Padding="0" MinWidth="0"
                        Background="Transparent"
                        Foreground="{DynamicResource App.TextInverseBrush}"
                        BorderThickness="0"
                        Click="OnCloseClicked"
                        ToolTip="إغلاق"/>
            </Grid>
        </Border>

        <!-- شريط الفلترة -->
        <Border Grid.Row="1" Padding="10,8"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="الكل" Tag="all" Click="OnFilterClicked"
                        Padding="8,3" Margin="0,0,4,0" FontSize="11"/>
                <Button Content="جديد" Tag="created" Click="OnFilterClicked"
                        Padding="8,3" Margin="0,0,4,0" FontSize="11"/>
                <Button Content="محدّث" Tag="updated" Click="OnFilterClicked"
                        Padding="8,3" Margin="0,0,4,0" FontSize="11"/>
                <Button Content="غير مشاهد" Tag="unseen" Click="OnFilterClicked"
                        Padding="8,3" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- قائمة الأحداث -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="6">
            <ItemsControl x:Name="PART_History">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="6"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUnseen}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource App.SurfaceBrush}"/>
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource App.PrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- أيقونة -->
                                <Border Grid.Column="0"
                                        Width="32" Height="32"
                                        CornerRadius="16"
                                        Background="{DynamicResource App.SurfaceBrush}"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- المحتوى -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.TextPrimaryBrush}"/>

                                    <TextBlock Text="{Binding Details}"
                                               FontSize="10"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.TextSecondaryBrush}"
                                               Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding KindLabel}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource App.PrimaryBrush}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding RelativeTime}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- جديد؟ -->
                                <Border Grid.Column="2"
                                        Width="8" Height="8"
                                        CornerRadius="4"
                                        Background="{DynamicResource App.PrimaryBrush}"
                                        VerticalAlignment="Top"
                                        Margin="4,4,0,0"
                                        Visibility="{Binding IsUnseen, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- شريط سفلي -->
        <Border Grid.Row="3"
                Padding="10,6"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="PART_Status"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"/>

                <Button Grid.Column="1"
                        Content="✅ تعليم الكل كمشاهَد"
                        Click="OnMarkAllSeenClicked"
                        Padding="8,3"
                        FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>