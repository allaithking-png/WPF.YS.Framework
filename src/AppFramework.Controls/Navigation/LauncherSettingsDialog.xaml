<Window x:Class="AppFramework.Controls.Navigation.LauncherSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات سطح المكتب"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource App.PrimaryBrush}" Padding="16,12">
            <TextBlock Text="⚙️ إعدادات سطح المكتب"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource App.TextInverseBrush}"/>
        </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="500">
      <StackPanel Margin="20,16">

        <!-- ============ المظهر ============ -->
        <TextBlock Text="🎨 المظهر" FontWeight="Bold" FontSize="13"
                   Foreground="{DynamicResource App.PrimaryBrush}"
                   Margin="0,0,0,10"/>

        <!-- حجم الأيقونة -->
        <TextBlock FontWeight="SemiBold" Margin="0,0,0,4">
            <Run Text="حجم الأيقونة:"/>
            <Run x:Name="PART_SizeValue" Text="96"/>
            <Run Text="px"/>
        </TextBlock>
        <Slider x:Name="PART_SizeSlider" Minimum="48" Maximum="160"
                TickFrequency="8" IsSnapToTickEnabled="True"
                ValueChanged="OnSizeChanged" Margin="0,0,0,16"/>

        <!-- حجم الخط -->
        <TextBlock FontWeight="SemiBold" Margin="0,0,0,4">
            <Run Text="حجم الخط:"/>
            <Run x:Name="PART_FontValue" Text="12"/>
            <Run Text="px"/>
        </TextBlock>
        <Slider x:Name="PART_FontSlider" Minimum="8" Maximum="20"
                TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="OnFontChanged" Margin="0,0,0,16"/>

        <!-- إظهار النص -->
        <CheckBox x:Name="PART_ShowLabelsCheck"
                  Content="إظهار أسماء العناصر"
                  Margin="0,0,0,8"/>

        <!-- شارات -->
        <CheckBox x:Name="PART_ShowBadgesCheck"
                  Content="عرض شارات (جديد / محدّث)"
                  Margin="0,0,0,8"/>

        <CheckBox x:Name="PART_ShowUnseenBadgeCheck"
                  Content="عرض عدد الأحداث غير المشاهدة"
                  Margin="0,0,0,16"/>

        <!-- فاصل -->
        <Separator Margin="0,0,0,16"/>

        <!-- ============ المجموعات ============ -->
        <TextBlock Text="📂 المجموعات المعروضة" FontWeight="Bold" FontSize="13"
                   Foreground="{DynamicResource App.PrimaryBrush}"
                   Margin="0,0,0,10"/>

        <CheckBox x:Name="PART_ShowPinnedCheck" Content="📌 المثبتة" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_ShowFavoritesCheck" Content="⭐ المفضلة" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_ShowMostUsedCheck" Content="🔥 الأكثر استخدامًا" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_ShowRecentCheck" Content="🕐 آخر ما فتحت" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_ShowNewCheck" Content="✨ الجديدة لك" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_ShowAllScreensCheck" Content="🖥️ كل الشاشات" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_ShowReportsCheck" Content="📊 التقارير" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_ShowExternalCheck" Content="🔗 عناصر خارجية" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_ShowMyItemsCheck" Content="✨ عناصري" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_ShowPersonalTreeCheck" Content="📁 ملفاتي" Margin="0,0,0,16"/>

        <!-- فاصل -->
        <Separator Margin="0,0,0,16"/>

        <!-- ============ السلوك ============ -->
        <TextBlock Text="⚙️ السلوك" FontWeight="Bold" FontSize="13"
                   Foreground="{DynamicResource App.PrimaryBrush}"
                   Margin="0,0,0,10"/>

        <CheckBox x:Name="PART_AllowFavoritesCheck" Content="السماح بالتفضيل" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_AllowPinningCheck" Content="السماح بالتثبيت" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_AllowHidingCheck" Content="السماح بالإخفاء" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_AllowDeletingCheck" Content="السماح بالحذف" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_AllowEditingCheck" Content="السماح بالتعديل" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_AllowAddingCheck" Content="السماح بالإضافة" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_AllowDragCheck" Content="تفعيل السحب والإفلات" Margin="0,0,0,6"/>
        <CheckBox x:Name="PART_ShowHistoryButtonCheck" Content="عرض زر سجل التغييرات" Margin="0,0,0,16"/>

        <!-- فاصل -->
        <Separator Margin="0,0,0,16"/>

        <!-- ============ سلوك النقر ============ -->
        <TextBlock Text="👆 سياسة النقر" FontWeight="Bold" FontSize="13"
                   Foreground="{DynamicResource App.PrimaryBrush}"
                   Margin="0,0,0,10"/>

        <ComboBox x:Name="PART_ClickPolicyCombo" MinHeight="32" Margin="0,0,0,16">
          <ComboBoxItem Content="نقر واحد = فتح" Tag="SingleClickToOpen"/>
          <ComboBoxItem Content="نقر مزدوج = فتح" Tag="DoubleClickToOpen"/>
          <ComboBoxItem Content="تحديد فقط" Tag="SelectOnly"/>
        </ComboBox>

        <!-- ============ الترتيب ============ -->
        <TextBlock Text="🔢 الترتيب" FontWeight="Bold" FontSize="13"
                   Foreground="{DynamicResource App.PrimaryBrush}"
                   Margin="0,0,0,10"/>

        <ComboBox x:Name="PART_SortCombo" MinHeight="32" Margin="0,0,0,16">
          <ComboBoxItem Content="يدوي (بالسحب)" Tag="Custom"/>
          <ComboBoxItem Content="أبجدي" Tag="Name"/>
          <ComboBoxItem Content="الأكثر استخدامًا" Tag="MostUsed"/>
          <ComboBoxItem Content="الأحدث" Tag="RecentlyUsed"/>
        </ComboBox>

        <!-- ============ استعادة الافتراضيات ============ -->
        <Separator Margin="0,0,0,16"/>

        <Button Content="🔄 استعادة الإعدادات الافتراضية"
                Click="OnResetToDefaultsClicked"
                Padding="12,8"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource App.SurfaceBrush}"
                Foreground="{DynamicResource App.TextPrimaryBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="1"/>

      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إلغاء" Click="OnCancelClicked"
                        Margin="0,0,8,0" MinWidth="100"
                        Background="{DynamicResource App.SurfaceBrush}"
                        Foreground="{DynamicResource App.TextPrimaryBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"/>
                <Button Content="💾 حفظ" Click="OnSaveClicked" MinWidth="120"
                        Background="{DynamicResource App.PrimaryBrush}"
                        Foreground="{DynamicResource App.TextInverseBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
