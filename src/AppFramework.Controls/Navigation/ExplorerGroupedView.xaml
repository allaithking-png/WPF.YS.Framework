<UserControl x:Class="AppFramework.Controls.Navigation.ExplorerGroupedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- شريط البحث -->
    <Border Grid.Row="0"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="🔍" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>

        <TextBox x:Name="PART_SearchBox" Grid.Column="1"
                         MinHeight="28" Padding="8,4"
                         VerticalContentAlignment="Center"/>

        <Button x:Name="PART_ClearButton" Grid.Column="2"
                        Content="✖" Width="26" Height="26"
                        Padding="0" MinWidth="0" Margin="6,0,0,0"
                        Visibility="Collapsed" Click="OnClearSearchClicked"/>
      </Grid>
    </Border>

    <!-- المجموعات -->
    <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="8,10">
      <ItemsControl x:Name="PART_Groups">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,20">
              <!-- رأس المجموعة -->
              <Grid Margin="4,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.PrimaryBrush}"/>

                <Border Grid.Column="2"
                                        Background="{DynamicResource App.SurfaceBrush}"
                                        CornerRadius="10" Padding="8,2">
                  <TextBlock Text="{Binding Items.Count}"
                                               FontSize="11"
                                               Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                </Border>
              </Grid>

              <Border Height="1" Margin="0,0,0,10"
                                    Background="{DynamicResource App.BorderBrush}"/>

              <!-- ✅ شبكة الأيقونات (DataTemplate مباشر) -->
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="110" Height="120"
        Margin="4"
        CornerRadius="8"
        Padding="8"
        Cursor="Hand"
        BorderThickness="2">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="BorderBrush" Value="Transparent"/>
                          <Style.Triggers>
                            <!-- Active -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="BorderBrush"
                            Value="{DynamicResource App.PrimaryBrush}"/>
                              <Setter Property="Background"
                            Value="{DynamicResource App.SurfaceBrush}"/>
                            </DataTrigger>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="BorderBrush"
                            Value="{DynamicResource App.BorderBrush}"/>
                              <Setter Property="Background"
                            Value="{DynamicResource App.SurfaceBrush}"/>
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>

                      <Border.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                          <MenuItem Header="📂 فتح" Click="OnIconOpenClicked"/>
                          <Separator/>
                          <MenuItem Header="📌 تثبيت / إلغاء" Click="OnIconTogglePinClicked"/>
                          <MenuItem Header="⭐ مفضلة / إلغاء" Click="OnIconToggleFavoriteClicked"/>
                          <Separator/>
                          <MenuItem Header="🚫 إخفاء" Click="OnIconHideClicked"/>
                        </ContextMenu>
                      </Border.ContextMenu>

                      <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                        <!-- الأيقونة -->
                        <Border Width="56" Height="56"
                CornerRadius="10"
                Margin="0,8,0,10"
                HorizontalAlignment="Center"
                Background="{DynamicResource App.SurfaceBrush}">
                          <TextBlock Text="{Binding Icon}"
                       FontSize="30"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- العنوان -->
                        <TextBlock Text="{Binding Title}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   FontSize="12"
                   FontWeight="SemiBold"
                   MaxWidth="96"
                   Foreground="{DynamicResource App.TextPrimaryBrush}"/>

                        <!-- مؤشرات -->
                        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0">
                          <TextBlock Text="⭐" FontSize="10" Margin="0,0,4,0"
                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                          <TextBlock Text="📌" FontSize="10" Margin="0,0,4,0"
                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                          <TextBlock Text="{Binding UsageCount, StringFormat=' ({0})'}"
                       FontSize="10"
                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                       Visibility="{Binding UsageCount, Converter={StaticResource ZeroToCollapsed}}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
