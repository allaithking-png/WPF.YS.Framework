<UserControl x:Class="AppFramework.Controls.Navigation.ExplorerTreeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- شريط البحث -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="🔍"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <TextBox x:Name="PART_SearchBox"
                         Grid.Column="1"
                         MinHeight="26"
                         Padding="6,3"
                         VerticalContentAlignment="Center"
                         ToolTip="ابحث في الشاشات والتقارير"/>

                <Button x:Name="PART_ClearButton"
                        Grid.Column="2"
                        Content="✖"
                        Width="24" Height="24"
                        Padding="0"
                        MinWidth="0"
                        Margin="4,0,0,0"
                        Visibility="Collapsed"
                        Click="OnClearSearchClicked"/>
            </Grid>
        </Border>

        <!-- الشجرة -->
        <TreeView x:Name="PART_Tree"
                  Grid.Row="1"
                  BorderThickness="0"
                  Padding="4"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  MouseDoubleClick="OnTreeMouseDoubleClick"
                  SelectedItemChanged="OnTreeSelectedItemChanged">
            <TreeView.ContextMenu>
                <ContextMenu x:Name="PART_ContextMenu">
                    <MenuItem x:Name="MI_Open" Header="📂 فتح" Click="OnOpenClicked"/>
                    <Separator/>
                    <MenuItem x:Name="MI_Pin" Header="📌 تثبيت / إلغاء" Click="OnTogglePinClicked"/>
                    <MenuItem x:Name="MI_Favorite" Header="⭐ مفضلة / إلغاء" Click="OnToggleFavoriteClicked"/>
                    <MenuItem x:Name="MI_Hide" Header="🚫 إخفاء" Click="OnHideClicked"/>
                    <Separator/>
                    <MenuItem x:Name="MI_Refresh" Header="🔄 تحديث" Click="OnRefreshClicked"/>
                </ContextMenu>
            </TreeView.ContextMenu>

            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="Padding" Value="2"/>
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{Binding Icon}"
                                   FontSize="14"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding Title}"
                                   VerticalAlignment="Center"/>

                        <!-- مؤشرات -->
                        <TextBlock Text="⭐"
                                   FontSize="11"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="📌"
                                   FontSize="11"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding UsageCount, StringFormat=' ({0})'}"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                   FontSize="10"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding UsageCount, Converter={StaticResource ZeroToCollapsed}}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>