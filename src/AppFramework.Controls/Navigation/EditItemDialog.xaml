<Window x:Class="AppFramework.Controls.Navigation.EditItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل عنصر"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource App.PrimaryBrush}" Padding="16,12">
            <TextBlock Text="✏️ تعديل العنصر"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource App.TextInverseBrush}"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,16">
            <TextBlock Text="العنوان" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="PART_TitleBox" MinHeight="32" Padding="8,4" Margin="0,0,0,14"/>

            <TextBlock Text="الأيقونة (إيموجي أو نص)" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="PART_IconBox" Grid.Column="0" MinHeight="32" Padding="8,4"
             FontSize="16"/>

        <Button x:Name="PART_PickIconButton" Grid.Column="1"
            Content="🎨" Width="36" Margin="6,0,0,0"
            Click="OnPickIconClicked"/>
      </Grid>
      <TextBlock Text="حجم مخصص (اختياري، بالبكسل)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="PART_SizeBox" MinHeight="32" Padding="8,4" Margin="0,0,0,14"/>

            <TextBlock Text="لون خلفية (HEX، مثال: #FF5722)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="PART_ColorBox" MinHeight="32" Padding="8,4"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إلغاء" Click="OnCancelClicked"
                        Margin="0,0,8,0" MinWidth="100"
                        Background="{DynamicResource App.SurfaceBrush}"
                        Foreground="{DynamicResource App.TextPrimaryBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"/>
                <Button Content="💾 حفظ" Click="OnSaveClicked" MinWidth="120"
                        Background="{DynamicResource App.PrimaryBrush}"
                        Foreground="{DynamicResource App.TextInverseBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
