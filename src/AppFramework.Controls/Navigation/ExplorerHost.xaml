<UserControl x:Class="AppFramework.Controls.Navigation.ExplorerHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AppFramework.Controls.Navigation"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- رأس Explorer -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.PrimaryBrush}"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="🗂️"
                           FontSize="18"
                           Foreground="{DynamicResource App.TextInverseBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBlock Grid.Column="1"
                           Text="مستكشف التنقل"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextInverseBrush}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="🔄"
                        ToolTip="تحديث الشجرة"
                        Click="OnRefreshClicked"
                        Background="Transparent"
                        Foreground="{DynamicResource App.TextInverseBrush}"
                        BorderThickness="0"
                        Padding="8,4"
                        MinWidth="0"/>
            </Grid>
        </Border>

        <!-- الشجرة -->

      <local:ExplorerTreeControl x:Name="PART_Tree" Grid.Row="1"/>
    </Grid>
</UserControl>
