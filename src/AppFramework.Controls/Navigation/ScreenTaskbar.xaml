<UserControl x:Class="AppFramework.Controls.Navigation.ScreenTaskbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Height="40">
    <Border Background="{DynamicResource App.SurfaceBrush}"
            BorderBrush="{DynamicResource App.BorderBrush}"
            BorderThickness="0,1,0,0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- أيقونة -->
      <TextBlock Grid.Column="0"
               Text="🖥️"
               FontSize="14"
               Margin="10,0"
               VerticalAlignment="Center"
               ToolTip="الشاشات المفتوحة"/>

      <!-- التبويبات -->
      <ScrollViewer Grid.Column="1"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  VerticalAlignment="Center">
        <ItemsControl x:Name="PART_Tabs">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="2,4"
                            Padding="12,4"
                            CornerRadius="4"
                            Cursor="Hand"
                            BorderThickness="2"
                            MouseLeftButtonDown="OnTabClicked"
                            MouseRightButtonUp="OnTabRightClicked">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background"
                                                Value="{DynamicResource App.BackgroundBrush}"/>
                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource App.PrimaryBrush}"/>
                      </DataTrigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background"
                                                Value="{DynamicResource App.BackgroundBrush}"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Icon}"
                                       FontSize="14"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Title}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextPrimaryBrush}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- حالة -->
      <TextBlock Grid.Column="2"
               x:Name="PART_Status"
               FontSize="10"
               Margin="10,0"
               VerticalAlignment="Center"
               Foreground="{DynamicResource App.TextSecondaryBrush}"/>

      <!-- ✅ فاصل -->
      <Separator Grid.Column="3" Width="1" Margin="6,8"
               Background="{DynamicResource App.BorderBrush}"/>

      <!-- ✅ Theme Switcher -->
      <StackPanel Grid.Column="4"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="6,0,10,0">
        <TextBlock Text="🎨" FontSize="14"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0"
                   ToolTip="تغيير الثيم"/>
        <ComboBox x:Name="PART_ThemeCombo"
                  MinWidth="100"
                  MinHeight="26"
                  FontSize="11"
                  Foreground="{DynamicResource App.TextPrimaryBrush}"
          Background="{DynamicResource App.SurfaceBrush}"
          BorderBrush="{DynamicResource App.BorderBrush}"
                  SelectionChanged="OnThemeChanged"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
