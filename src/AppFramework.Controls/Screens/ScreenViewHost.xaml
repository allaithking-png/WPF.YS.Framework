<UserControl x:Class="AppFramework.Controls.Screens.ScreenViewHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">
  <Grid>
    <Grid.RowDefinitions>
      <!-- 0: Toolbar -->
      <RowDefinition Height="Auto"/>
      <!-- 1: Search -->
      <RowDefinition Height="Auto"/>
      <!-- 2: Content -->
      <RowDefinition Height="*"/>
      <!-- 3: Pagination -->
      <RowDefinition Height="Auto"/>
      <!-- 4: Status -->
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- شريط الأدوات الديناميكي -->
    <Border x:Name="PART_ToolbarBorder"
                Grid.Row="0"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
      <StackPanel Orientation="Horizontal" x:Name="PART_Toolbar">
        <!-- العنوان -->
        <TextBlock x:Name="PART_Title"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource App.PrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

        <!-- أزرار الأوامر -->
        <ContentControl x:Name="PART_ActionsHost" VerticalAlignment="Center"/>

        <!-- فاصل -->
        <Separator Margin="10,0" Width="1"
                           Background="{DynamicResource App.BorderBrush}"/>

        <!-- أزرار طرق العرض -->
        <ContentControl x:Name="PART_ViewModesHost" VerticalAlignment="Center"/>

        <!-- فاصل -->
        <Separator Margin="10,0" Width="1"
                           Background="{DynamicResource App.BorderBrush}"/>

        <!-- أزرار التقارير -->
        <ContentControl x:Name="PART_ReportsHost" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    <!-- شريط البحث -->
    <Border Grid.Row="1"
        Background="{DynamicResource App.SurfaceBrush}"
        BorderBrush="{DynamicResource App.BorderBrush}"
        BorderThickness="0,0,0,1"
        Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="🔍"
                   FontSize="16"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"/>

        <TextBox x:Name="PART_SearchBox"
                 Grid.Column="1"
                 MinHeight="28"
                 Padding="8,4"
                 VerticalContentAlignment="Center"/>

        <Button x:Name="PART_ClearSearchButton"
                Grid.Column="2"
                Content="✖"
                Width="28" Height="28"
                Padding="0"
                MinWidth="0"
                Margin="6,0,0,0"
                Visibility="Collapsed"
                ToolTip="مسح البحث"
                Click="OnClearSearchClicked"/>
      </Grid>
    </Border>
    <!-- محتوى العرض -->
    <ContentControl Grid.Row="2" x:Name="PART_ContentHost" Margin="8"/>
    <!-- شريط Pagination -->
    <Border Grid.Row="3"
        Background="{DynamicResource App.SurfaceBrush}"
        BorderBrush="{DynamicResource App.BorderBrush}"
        BorderThickness="0,1,0,0"
        Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding PageStatus}"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource App.TextSecondaryBrush}"/>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

          <Button Content="⏮"
                    Command="{Binding GoFirstPageCommand}"
                    IsEnabled="{Binding CanGoPrevious}"
                    Padding="10,4"
                    MinWidth="36"
                    Margin="0,0,4,0"
                    ToolTip="الصفحة الأولى"/>

          <Button Content="◀"
                    Command="{Binding GoPreviousPageCommand}"
                    IsEnabled="{Binding CanGoPrevious}"
                    Padding="10,4"
                    MinWidth="36"
                    Margin="0,0,4,0"
                    ToolTip="السابق"/>

          <TextBlock Text="{Binding CurrentPage}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Margin="8,0"
                       FontSize="13"/>

          <TextBlock Text="من"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                       Margin="0,0,8,0"
                       FontSize="11"/>

          <TextBlock Text="{Binding TotalPages}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Margin="0,0,8,0"
                       FontSize="13"/>

          <Button Content="▶"
                    Command="{Binding GoNextPageCommand}"
                    IsEnabled="{Binding CanGoNext}"
                    Padding="10,4"
                    MinWidth="36"
                    Margin="0,0,4,0"
                    ToolTip="التالي"/>

          <Button Content="⏭"
                    Command="{Binding GoLastPageCommand}"
                    IsEnabled="{Binding CanGoNext}"
                    Padding="10,4"
                    MinWidth="36"
                    ToolTip="الصفحة الأخيرة"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- شريط الحالة -->
    <Border Grid.Row="4"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
      <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                       FontSize="11"/>
    </Border>
  </Grid>
</UserControl>
