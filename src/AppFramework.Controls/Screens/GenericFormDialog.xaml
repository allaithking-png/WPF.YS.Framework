<Window x:Class="AppFramework.Controls.Screens.GenericFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Width="520"
        SizeToContent="Height"
        MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الرأس -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.PrimaryBrush}"
                Padding="16,12">
            <TextBlock x:Name="PART_Title"
                       Text="{Binding DialogTitle}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource App.TextInverseBrush}"/>
        </Border>

        <!-- الحقول (ScrollViewer) -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="500"
                      Padding="20,16">
            <StackPanel x:Name="PART_FieldsHost"/>
        </ScrollViewer>

        <!-- الأزرار -->
        <Border Grid.Row="2"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إلغاء"
                        Click="OnCancelClicked"
                        Margin="0,0,8,0"
                        MinWidth="100"
                        Background="{DynamicResource App.SurfaceBrush}"
                        Foreground="{DynamicResource App.TextPrimaryBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"/>

                <Button Content="💾 حفظ"
                        Click="OnSaveClicked"
                        MinWidth="120"
                        Background="{DynamicResource App.PrimaryBrush}"
                        Foreground="{DynamicResource App.TextInverseBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>